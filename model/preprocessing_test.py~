import matplotlib.pyplot as plt
import torch
from PIL import Image
from torchvision import transforms

# use SAME transform you are testing
transform = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.CenterCrop(224),
    transforms.ToTensor(),
])

def show_before_after(image_path):
    img = Image.open(image_path).convert("RGB")

    tensor = transform(img)

    # denormalize (ONLY if normalized; safe version here assumes no normalization)
    to_pil = transforms.ToPILImage()
    processed = to_pil(tensor)

    plt.figure(figsize=(8,4))

    plt.subplot(1,2,1)
    plt.title("Original")
    plt.imshow(img)
    plt.axis("off")

    plt.subplot(1,2,2)
    plt.title("Preprocessed")
    plt.imshow(processed)
    plt.axis("off")

    plt.show()


# test on random samples
import os, random

def test_random_samples(image_folder, n=5):
    images = os.listdir(image_folder)
    samples = random.sample(images, n)

    for img in samples:
        show_before_after(os.path.join(image_folder, img))
